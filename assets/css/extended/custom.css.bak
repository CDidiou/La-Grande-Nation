.chapter-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}

.chapter-prev,
.chapter-next,
.chapter-middle {
    font-size: 0.8em; 
}

.chapter-prev {
  text-align: left;
}

.chapter-next {
  text-align: right;
  margin-left: auto; /* Pousse le lien suivant tout à droite si le lien du milieu est absent */
}

/* On cible correctement la classe .chapter-middle (avec un point .) */
.chapter-middle a.chapter-middle {
  text-align: center;
  font-style: italic;
}

.post-content p {
    margin-bottom: 1.2em;
}

.post-subtitle {
  font-style: italic;
  font-size: 1.5rem;
}